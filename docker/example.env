# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables

# The location where your uploaded files are stored
UPLOAD_LOCATION=./library

# The location where your database files are stored. Network shares are not supported for the database
DB_DATA_LOCATION=./postgres

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# TZ=Etc/UTC

# The Immich version to use. You can pin this to a specific version like "v2.1.0"
IMMICH_VERSION=v3

# Connection secret for postgres. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=postgres

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Local, disposable cache for derived files (thumbnails, transcodes) and for the
# originals that jobs are working on. Nothing in it is written to UPLOAD_LOCATION
# or the object store — it can be deleted at any time.
#IMMICH_CACHE_LOCATION=/cache
# Set to 'off' to never generate thumbnails (clients then read the originals)
#IMMICH_THUMBNAILS=cache

# Local copies of recently used originals, so the jobs an upload queues (metadata
# extraction, thumbnails) do not download back the bytes that were just sent.
# MiB of room (0 disables the cache), and how long an *unused* copy survives.
#IMMICH_ORIGINAL_CACHE_MB=2048
#IMMICH_ORIGINAL_CACHE_TTL=900

# Store the library in a Volcengine TOS bucket. Leave unset (or `local`) to keep it
# on the filesystem.
#IMMICH_STORAGE_BACKEND=tos
# endpoint has no scheme and no bucket name
#TOS_ENDPOINT=tos-cn-beijing.volces.com
#TOS_REGION=cn-beijing
#TOS_BUCKET=my-family-photos
#TOS_ACCESS_KEY_ID=
#TOS_ACCESS_KEY_SECRET=
#TOS_PREFIX=immich/
#TOS_PRESIGN_TTL=3600
